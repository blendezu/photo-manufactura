{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default (Release)",
            "description": "Standard release build with optimizations",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "description": "Debug build with symbols and no optimization",
            "inherits": [
                "default"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS_DEBUG": "-g -O0"
            }
        },
        {
            "name": "dev",
            "displayName": "Development",
            "description": "Debug build with extra warnings for development",
            "inherits": [
                "debug"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wpedantic -Wconversion -Wshadow"
            }
        },
        {
            "name": "release-optimized",
            "displayName": "Release (Optimized)",
            "description": "Highly optimized release build",
            "inherits": [
                "default"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -march=native -flto"
            }
        },
        {
            "name": "macos-arm64",
            "displayName": "macOS ARM64",
            "description": "macOS ARM64 specific build",
            "inherits": [
                "default"
            ],
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
            }
        },
        {
            "name": "component-debug",
            "displayName": "Component Debug",
            "description": "Debug preset for individual component development",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_CXX_FLAGS": "-Wall -Wextra -g -O0"
            }
        },
        {
            "name": "component-release",
            "displayName": "Component Release",
            "description": "Release preset for individual component development",
            "inherits": [
                "component-debug"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS": "-O2 -DNDEBUG"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "displayName": "Default Build",
            "configurePreset": "default",
            "targets": [],
            "jobs": 8,
            "cleanFirst": false
        },
        {
            "name": "debug",
            "displayName": "Debug Build",
            "configurePreset": "debug",
            "targets": [],
            "jobs": 8
        },
        {
            "name": "dev",
            "displayName": "Development Build",
            "configurePreset": "dev",
            "targets": [],
            "jobs": 8
        },
        {
            "name": "release-optimized",
            "displayName": "Optimized Release",
            "configurePreset": "release-optimized",
            "targets": [],
            "jobs": 8
        },
        {
            "name": "ui-component",
            "displayName": "UI Component Only",
            "configurePreset": "default",
            "targets": [
                "ui"
            ],
            "jobs": 4
        },
        {
            "name": "controller-component",
            "displayName": "Controller Component Only",
            "configurePreset": "default",
            "targets": [
                "controller"
            ],
            "jobs": 4
        },
        {
            "name": "all-components",
            "displayName": "All Components",
            "configurePreset": "default",
            "targets": [
                "ui",
                "controller",
                "image_processing",
                "raw_processing",
                "scheduler_worker"
            ],
            "jobs": 8
        },
        {
            "name": "clean-build",
            "displayName": "Clean Build",
            "configurePreset": "default",
            "targets": [],
            "jobs": 8,
            "cleanFirst": true
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "displayName": "All Tests",
            "configurePreset": "default",
            "execution": {
                "jobs": 4
            }
        },
        {
            "name": "debug",
            "displayName": "Debug Tests",
            "configurePreset": "debug",
            "execution": {
                "jobs": 4
            }
        },
        {
            "name": "ui-tests",
            "displayName": "UI Component Tests",
            "configurePreset": "default",
            "filter": {
                "include": {
                    "name": "ui.*"
                }
            }
        },
        {
            "name": "controller-tests",
            "displayName": "Controller Component Tests",
            "configurePreset": "default",
            "filter": {
                "include": {
                    "name": "controller.*"
                }
            }
        },
        {
            "name": "parallel-tests",
            "displayName": "Parallel Component Tests",
            "configurePreset": "default",
            "execution": {
                "jobs": 8
            }
        }
    ],
    "packagePresets": [
        {
            "name": "default",
            "configurePreset": "default"
        }
    ]
}