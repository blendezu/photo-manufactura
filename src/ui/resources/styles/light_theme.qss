/* ============================================================
 * Photo Manufactura - Light Theme
 * Clean light theme for photo editing
 * ============================================================ */

/* Main Window */
QMainWindow {
    background-color: #f5f5f5;
}

/* Dock Widgets */
QDockWidget {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    color: #333333;
}

QDockWidget::title {
    background-color: #e0e0e0;
    padding: 6px;
    text-align: left;
}

/* Group Box */
QGroupBox {
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 5px;
    margin-top: 12px;
    padding-top: 10px;
    background-color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #0078d4;
    font-weight: bold;
}

/* Labels */
QLabel {
    color: #333333;
    background-color: transparent;
}

/* Slider */
QSlider::groove:horizontal {
    background: #d0d0d0;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #0078d4;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #1084d8;
}

QSlider::sub-page:horizontal {
    background: #0078d4;
    border-radius: 3px;
}

/* SpinBox */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 3px;
    padding: 3px;
    color: #333333;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #0078d4;
}

/* Buttons */
QPushButton {
    background-color: #0078d4;
    color: white;
    border: none;
    padding: 6px 12px;
    border-radius: 3px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #1084d8;
}

QPushButton:pressed {
    background-color: #006cc1;
}

QPushButton:disabled {
    background-color: #d0d0d0;
    color: #999999;
}

/* Menu Bar */
QMenuBar {
    background-color: #e0e0e0;
    color: #333333;
    border-bottom: 1px solid #d0d0d0;
}

QMenuBar::item {
    padding: 4px 12px;
    background-color: transparent;
}

QMenuBar::item:selected {
    background-color: #d0d0d0;
}

QMenuBar::item:pressed {
    background-color: #0078d4;
    color: white;
}

/* Menu */
QMenu {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    color: #333333;
}

QMenu::item {
    padding: 6px 30px 6px 20px;
}

QMenu::item:selected {
    background-color: #0078d4;
    color: white;
}

QMenu::separator {
    height: 1px;
    background-color: #d0d0d0;
    margin: 4px 0;
}

/* Scroll Bar */
QScrollBar:vertical {
    background-color: #f5f5f5;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    min-height: 30px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}

QScrollBar:horizontal {
    background-color: #f5f5f5;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #c0c0c0;
    min-width: 30px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #a0a0a0;
}

/* Status Bar */
QStatusBar {
    background-color: #e0e0e0;
    color: #333333;
    border-top: 1px solid #d0d0d0;
}
