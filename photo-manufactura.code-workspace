{
    "folders": [
        {
            "name": "📁 Main Project",
            "path": "."
        },
        {
            "name": "🖼️ UI Component",
            "path": "./src/ui"
        },
        {
            "name": "🎮 Controller Component",
            "path": "./src/controller"
        },
        {
            "name": "🎨 Image Processing",
            "path": "./src/image_processing"
        },
        {
            "name": "📸 RAW Processing",
            "path": "./src/raw_processing"
        },
        {
            "name": "⚡ Scheduler Worker",
            "path": "./src/scheduler_worker"
        }
    ],
    "settings": {
        "cmake.useCMakePresets": "always",
        "cmake.configureOnOpen": false,
        "cmake.generator": "Ninja",
        "cmake.buildDirectory": "${workspaceFolder}/build/${command:cmake.activeConfigurePresetName}",
        "clangd.arguments": [
            "--clang-tidy",
            "--compile-commands-dir=${workspaceFolder}/build/${command:cmake.activeConfigurePresetName}"
        ],
        "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "extensions": {
        "recommendations": [
            "ms-vscode.cmake-tools",
            "ms-vscode.cpptools",
            "llvm-vs-code-extensions.vscode-clangd"
        ]
    }
}