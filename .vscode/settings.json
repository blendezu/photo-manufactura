{
    // Enable format on save for C/C++ files using clang-format
    "editor.formatOnSave": true,
    // Specify clangFormat as the formatter for C/C++
    "C_Cpp.formatting": "clangFormat",
    // Set clangd as the default formatter
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    // ✅ CMake integration
    "cmake.useCMakePresets": "always",
    // Use CMake Tools as the configuration provider for C/C++
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    // ✅ clangd setup for Qt
    "clangd.arguments": [
        "--clang-tidy", // Enable clang-tidy diagnostics
        "--compile-commands-dir=build/default" // Path to compile_commands.json
    ],
    // File associations for C/C++ files
    "files.associations": {
        "*.h": "cpp",
        "*.hpp": "cpp",
        "*.cpp": "cpp"
    },
    // ✅ CMake Tools Configuration
    "cmake.configureOnOpen": true,
    "cmake.buildDirectory": "${workspaceFolder}/build/${buildType}",
    "cmake.generator": "Ninja",
    "cmake.preferredGenerators": [
        "Ninja",
        "Unix Makefiles"
    ],
    "cmake.configureArgs": [
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
    ],
    "cmake.buildArgs": [
        "-j8"
    ],
    "cmake.parallelJobs": 8,
    "cmake.showSystemKits": false,
    "cmake.automaticReconfigure": true,
    // ✅ Component Development Settings
    "cmake.buildBeforeRun": true,
    "cmake.clearOutputBeforeBuild": true,
    "cmake.saveBeforeBuild": true,
    "cmake.skipConfigureIfCachePresent": false,
    // ✅ CMake Presets Integration
    "cmake.allowCommentsInPresetsFile": true,
    "cmake.configureOnEdit": false
}